# BlueBubbles (macOS server on the same LAN)
BLUEBUBBLES_SERVER_URL=http://192.168.0.26:1234
BLUEBUBBLES_PASSWORD=
# apple-script, because private_api is false on this server (1.9.9)
# Verified: the send endpoint accepts the `message` field, and chat creation
# requires a first message on macOS Big Sur and later.
BLUEBUBBLES_METHOD=apple-script
# Optional: pin a chat instead of creating one by address
BLUEBUBBLES_CHAT_GUID=

# Model access: any OpenAI-compatible endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# openrouter/free routes to a random free model and can return junk, so pin a specific one.
# Verified 17 Oct 2026: this model answers in about 3.8 seconds.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# echo = one-shot reply, agent = the existing multi-turn IntakeAgent
MODE=echo
# Never reply to these addresses, comma separated. The server's own address is
# added automatically. Replies to yourself arrive as inbound and loop forever.
IGNORE_SENDERS=sidhari25@outlook.com
# Ignore messages older than this on startup, so a restart cannot answer
# yesterday's backlog.
STALE_SECONDS=120
