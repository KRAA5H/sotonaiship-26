# BlueBubbles (macOS server on the same LAN)
BLUEBUBBLES_SERVER_URL=http://192.168.0.26:1234
BLUEBUBBLES_PASSWORD=
# apple-script, because private_api is false on this server (1.9.9)
# Verified: the send endpoint accepts the `message` field, and chat creation
# requires a first message on macOS Big Sur and later.
BLUEBUBBLES_METHOD=apple-script
# Optional: pin a chat instead of creating one by address
BLUEBUBBLES_CHAT_GUID=

# Model access: any OpenAI-compatible endpoint
# Text provider: DeepSeek (OpenAI-compatible). This is the default for text.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Photo provider: any OpenAI-compatible vision endpoint. OpenRouter free models
# are rate limited to 50 requests a day, so 10 USD of credit unlocks 1000.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# openrouter/free routes to a random free model and can return junk, so pin a specific one.
# Verified 17 Oct 2026: this model answers in about 3.8 seconds.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Vision is a separate model. This one read a real inbound photo correctly in ~12s.
# gemma-4-31b:free was rate limited at test time and inkling:free needs a different harness.
LLM_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# echo = one-shot reply, agent = the existing multi-turn IntakeAgent
MODE=echo
# Never reply to these addresses, comma separated. The server's own address is
# added automatically. Replies to yourself arrive as inbound and loop forever.
IGNORE_SENDERS=sidhari25@outlook.com
# Ignore messages older than this on startup, so a restart cannot answer
# yesterday's backlog.
STALE_SECONDS=120

# Reports database and agent tools (code/reports_db.py, code/tools.py)
# Defaults to code/kerbside.db. Never commit the .db file.
DB_PATH=
# Secret salt for hashing the sender into reporter_ref. Set any long random string.
REPORTER_SALT=
# Base of every link a resident gets: their report (<SITE_URL>/r/<token>) and the
# drop-a-pin map (<SITE_URL>/p/<token>), both served by the bot on port 5005.
# Use an HTTPS address a phone can reach (a tunnel is fine): phones only allow
# "use my current location" on HTTPS pages.
SITE_URL=http://localhost:5005
# Optional: serve the map somewhere else. Defaults to SITE_URL.
PIN_BASE_URL=
# Seconds before a slow model call is skipped (triage 10, reply 6 and photo 12 override it)
LLM_TIMEOUT=15
# Password for /council (HTTP Basic, any username). Without it /council is off.
COUNCIL_PASSWORD=
# Port for running code/website.py on its own; normally blue_bubbles.py serves it on 5005
WEB_PORT=5006
# Password for /council (HTTP Basic, any username). Without it /council is off.
COUNCIL_PASSWORD=
# Port for running code/website.py on its own; normally blue_bubbles.py serves it on 5005
WEB_PORT=5006
